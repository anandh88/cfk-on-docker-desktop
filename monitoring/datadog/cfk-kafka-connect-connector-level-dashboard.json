{
  "id": "t3n-whd-jz3",
  "title": "CFK Kafka Connect Connector Level",
  "description": "Connector instance level monitoring for Kafka Connect on CFK.",
  "layout_type": "ordered",
  "url": "/dashboard/t3n-whd-jz3/cfk-kafka-connect-connector-level",
  "template_variables": [],
  "widgets": [
    {
      "definition": {
        "type": "query_value",
        "title": "Running Connectors",
        "requests": [
          {
            "q": "count_nonzero(sum:confluent.kafka.connect.worker.connector_running_task_count{kube_namespace:confluent,kube_container_name:connect} by {connector})"
          }
        ],
        "autoscale": true,
        "precision": 0
      }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "Failed Connectors",
        "requests": [
          {
            "q": "count_nonzero(sum:confluent.kafka.connect.worker.connector_failed_task_count{kube_namespace:confluent,kube_container_name:connect} by {connector})"
          }
        ],
        "autoscale": true,
        "precision": 0
      }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "Paused Connectors",
        "requests": [
          {
            "q": "count_nonzero(sum:confluent.kafka.connect.worker.connector_paused_task_count{kube_namespace:confluent,kube_container_name:connect} by {connector})"
          }
        ],
        "autoscale": true,
        "precision": 0
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Task Status by Connector",
        "requests": [
          {
            "q": "sum:confluent.kafka.connect.worker.connector_running_task_count{kube_namespace:confluent,kube_container_name:connect} by {connector}"
          },
          {
            "q": "sum:confluent.kafka.connect.worker.connector_failed_task_count{kube_namespace:confluent,kube_container_name:connect} by {connector}"
          },
          {
            "q": "sum:confluent.kafka.connect.worker.connector_paused_task_count{kube_namespace:confluent,kube_container_name:connect} by {connector}"
          }
        ],
        "yaxis": {
          "scale": "linear",
          "include_zero": true,
          "min": "auto",
          "max": "auto"
        }
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Total Tasks by Connector",
        "requests": [
          {
            "q": "sum:confluent.kafka.connect.worker.connector_total_task_count{kube_namespace:confluent,kube_container_name:connect} by {connector}"
          }
        ],
        "yaxis": {
          "scale": "linear",
          "include_zero": true,
          "min": "auto",
          "max": "auto"
        }
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Messages/sec by Connector",
        "requests": [
          {
            "q": "avg:confluent.kafka.connect.source_task.source_record_write_rate{kube_namespace:confluent,kube_container_name:connect} by {connector}"
          }
        ],
        "yaxis": {
          "scale": "linear",
          "include_zero": true,
          "min": "auto",
          "max": "auto"
        }
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Source Active Records by Connector",
        "requests": [
          {
            "q": "avg:confluent.kafka.connect.source_task.source_record_active_count_avg{kube_namespace:confluent,kube_container_name:connect} by {connector}"
          }
        ],
        "yaxis": {
          "scale": "linear",
          "include_zero": true,
          "min": "auto",
          "max": "auto"
        }
      }
    },
    {
