{
  "id": "3ve-vir-6zg",
  "title": "CFK Kafka Connect Enriched",
  "description": "Kafka Connect runtime dashboard aligned to container memory, CPU, and JVM panels.",
  "layout_type": "ordered",
  "url": "/dashboard/3ve-vir-6zg/cfk-kafka-connect-enriched",
  "template_variables": [],
  "widgets": [
    {
      "definition": {
        "type": "timeseries",
        "title": "JVM Heap Used vs Max",
        "requests": [
          {
            "q": "avg:jvm.heap_memory{kube_namespace:confluent,kube_container_name:connect}"
          },
          {
            "q": "avg:jvm.heap_memory_max{kube_namespace:confluent,kube_container_name:connect}"
          }
        ],
        "yaxis": {
          "scale": "linear",
          "include_zero": true,
          "min": "auto",
          "max": "auto"
        }
      }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "JVM Heap Utilization %",
        "requests": [
          {
            "q": "(avg:jvm.heap_memory{kube_namespace:confluent,kube_container_name:connect}/avg:jvm.heap_memory_max{kube_namespace:confluent,kube_container_name:connect})*100"
          }
        ],
        "autoscale": true,
        "precision": 1
      }
    },
    {
