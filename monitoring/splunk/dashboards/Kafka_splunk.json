      "title": "Active Controllers",
      "dataSources": {
        "primary": "ds_p2"
      },
      "options": {
        "numberPrecision": 0,
        "majorColor": "> majorValue | rangeValue(majorColorEditorConfig)"
      },
      "context": {
        "majorColorEditorConfig": [
          {
            "to": 0.999,
            "value": "#d03b3b"
          },
          {
            "from": 0.999,
            "to": 1.001,
            "value": "#0ca30c"
          },
          {
            "from": 1.001,
