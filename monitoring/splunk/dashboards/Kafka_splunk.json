  "dataSources": {
    "ds_p2": {
      "type": "ds.search",
      "options": {
        "query": "| mstats latest(_value) as value WHERE index=cfk_metrics metric_name=\"kafka_controller_kafkacontroller_value\" namespace=\"confluent\" env=\"$env$\" cluster=\"$cluster$\" name=\"ActiveControllerCount\" service.name=\"kafka-controller\"",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "name": "search"
    },
    "ds_p3": {
      "type": "ds.search",
      "options": {
        "query": "| mstats latest(_value) as value WHERE index=cfk_metrics metric_name=\"kafka_server_replicamanager_value\" namespace=\"confluent\" env=\"$env$\" cluster=\"$cluster$\" name=\"LeaderCount\" service.name=\"kafka-broker\" service.instance.id=\"$instance$\" BY service.instance.id\n| stats dc(service.instance.id) as value",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "name": "search"
    },
    "ds_p6": {
      "type": "ds.search",
      "options": {
        "query": "| mstats sum(_value) as value WHERE index=cfk_metrics metric_name=\"kafka_controller_controllerstats_oneminuterate\" namespace=\"confluent\" env=\"$env$\" cluster=\"$cluster$\" name=\"UncleanLeaderElectionsPerSec\" service.name=\"kafka-controller\" span=1m\n| stats latest(value) as value",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "name": "search"
    },
    "ds_p7": {
      "type": "ds.search",
      "options": {
        "query": "| mstats latest(_value) as value WHERE index=cfk_metrics metric_name=\"kafka_server_replicamanager_value\" namespace=\"confluent\" env=\"$env$\" cluster=\"$cluster$\" name=\"UnderReplicatedPartitions\" service.name=\"kafka-broker\" service.instance.id=\"$instance$\" BY service.instance.id\n| stats sum(value) as value",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "name": "search"
    },
    "ds_p8": {
      "type": "ds.search",
      "options": {
        "query": "| mstats latest(_value) as value WHERE index=cfk_metrics metric_name=\"kafka_server_replicamanager_value\" namespace=\"confluent\" env=\"$env$\" cluster=\"$cluster$\" name=\"UnderMinIsrPartitionCount\" service.name=\"kafka-broker\" BY service.instance.id\n| stats sum(value) as value",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "name": "search"
    },
    "ds_p9": {
      "type": "ds.search",
      "options": {
        "query": "| mstats latest(_value) as value WHERE index=cfk_metrics metric_name=\"kafka_controller_kafkacontroller_value\" namespace=\"confluent\" env=\"$env$\" cluster=\"$cluster$\" name=\"OfflinePartitionsCount\" service.name=\"kafka-controller\" BY service.instance.id\n| stats sum(value) as value",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "name": "search"
    },
    "ds_p12": {
      "type": "ds.search",
      "options": {
        "query": "| mstats sum(_value) as value WHERE index=cfk_metrics metric_name=\"kafka_server_brokertopicmetrics_count\" namespace=\"confluent\" env=\"$env$\" cluster=\"$cluster$\" name=\"BytesInPerSec\" service.name=\"kafka-broker\" service.instance.id=\"$instance$\" topic!=\"\"  span=1m\n| streamstats current=f window=1 global=f last(value) as prev_value last(_time) as prev_time\n| eval value=if(isnotnull(prev_value) AND (_time-prev_time)>0, (value-prev_value)/(_time-prev_time), null())\n| eval series=\"bytes_in\"\n| append [\n| mstats sum(_value) as value WHERE index=cfk_metrics metric_name=\"kafka_server_brokertopicmetrics_count\" namespace=\"confluent\" env=\"$env$\" cluster=\"$cluster$\" name=\"BytesOutPerSec\" service.name=\"kafka-broker\" service.instance.id=\"$instance$\" topic!=\"\"  span=1m\n| streamstats current=f window=1 global=f last(value) as prev_value last(_time) as prev_time\n| eval value=if(isnotnull(prev_value) AND (_time-prev_time)>0, (value-prev_value)/(_time-prev_time), null())\n| eval series=\"bytes_out\"\n]\n| timechart span=1m avg(value) by series",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "name": "search"
    },
    "ds_p22": {
      "type": "ds.search",
      "options": {
        "query": "| mstats sum(_value) as value WHERE index=cfk_metrics metric_name=\"kafka_network_requestmetrics_count\" namespace=\"confluent\" env=\"$env$\" cluster=\"$cluster$\" name=\"ErrorsPerSec\" service.name=\"kafka-broker\" service.instance.id=\"$instance$\" error!=\"NONE\"  BY error span=1m\n| streamstats current=f window=1 global=f last(value) as prev_value last(_time) as prev_time by error\n| eval rate=if(isnotnull(prev_value) AND (_time-prev_time)>0, (value-prev_value)/(_time-prev_time), null())\n| timechart span=1m avg(rate) by error",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "name": "search"
    },
    "ds_p24": {
      "type": "ds.search",
      "options": {
        "query": "| mstats sum(_value) as value WHERE index=cfk_metrics metric_name=\"process_cpu_seconds_total\" namespace=\"confluent\" env=\"$env$\" cluster=\"$cluster$\" service.name=\"kafka-broker\" service.instance.id=\"$instance$\" BY service.instance.id span=1m\n| streamstats current=f window=1 global=f last(value) as prev_value last(_time) as prev_time by service.instance.id\n| eval rate=if(isnotnull(prev_value) AND (_time-prev_time)>0, (value-prev_value)/(_time-prev_time)*100, null())\n| timechart span=1m avg(rate) by service.instance.id",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "name": "search"
    },
    "ds_p25": {
      "type": "ds.search",
      "options": {
        "query": "| mstats avg(_value) as value WHERE index=cfk_metrics metric_name=\"jvm_memory_bytes_used\" namespace=\"confluent\" env=\"$env$\" cluster=\"$cluster$\" service.name=\"kafka-broker\" service.instance.id=\"$instance$\"  BY service.instance.id span=1m\n| eval series=\"used\".\"-\".'service.instance.id'\n| append [\n| mstats avg(_value) as value WHERE index=cfk_metrics metric_name=\"jvm_memory_bytes_max\" namespace=\"confluent\" env=\"$env$\" cluster=\"$cluster$\" service.name=\"kafka-broker\" service.instance.id=\"$instance$\" area=\"heap\"  BY service.instance.id span=1m\n| eval series=\"max_heap\".\"-\".'service.instance.id'\n]\n| timechart span=1m avg(value) by series",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "name": "search"
    },
    "ds_p26": {
      "type": "ds.search",
      "options": {
        "query": "| mstats sum(_value) as value WHERE index=cfk_metrics metric_name=\"jvm_gc_collection_seconds_sum\" namespace=\"confluent\" env=\"$env$\" cluster=\"$cluster$\" service.name=\"kafka-broker\" service.instance.id=\"$instance$\"  BY service.instance.id span=1m\n| streamstats current=f window=1 global=f last(value) as prev_value last(_time) as prev_time by service.instance.id\n| eval rate=if(isnotnull(prev_value) AND (_time-prev_time)>0, (value-prev_value)/(_time-prev_time), null())\n| timechart span=1m avg(rate) by service.instance.id",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "name": "search"
    },
    "ds_p28": {
      "type": "ds.search",
      "options": {
        "query": "| mstats sum(_value) as value WHERE index=cfk_metrics metric_name=\"kafka_server_kafkaserver_value\" namespace=\"confluent\" env=\"$env$\" cluster=\"$cluster$\" name=\"linux-disk-write-bytes\" service.name=\"kafka-broker\" service.instance.id=\"$instance$\"  BY service.instance.id span=1m\n| streamstats current=f window=1 global=f last(value) as prev_value last(_time) as prev_time by service.instance.id\n| eval rate=if(isnotnull(prev_value) AND (_time-prev_time)>0, (value-prev_value)/(_time-prev_time), null())\n| timechart span=1m avg(rate) by service.instance.id",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "name": "search"
    },
    "ds_p30": {
      "type": "ds.search",
      "options": {
        "query": "| mstats sum(_value) as value WHERE index=cfk_metrics metric_name=\"kafka_server_brokertopicmetrics_count\" namespace=\"confluent\" env=\"$env$\" cluster=\"$cluster$\" name=\"MessagesInPerSec\" service.name=\"kafka-broker\" topic!=\"\"  span=1m\n| streamstats current=f window=1 global=f last(value) as prev_value last(_time) as prev_time\n| eval rate=if(isnotnull(prev_value) AND (_time-prev_time)>0, (value-prev_value)/(_time-prev_time), null())\n| timechart span=1m avg(rate)",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "name": "search"
    },
    "ds_p58": {
      "type": "ds.search",
      "options": {
        "query": "| mstats max(_value) as value WHERE index=cfk_metrics metric_name=\"kafka_consumer_consumer_fetch_manager_metrics_records_lag_max\" namespace=\"confluent\" env=\"$env$\" cluster=\"$cluster$\" service.name=\"kafka-connect\" topic=\"$topic$\" BY client_id,topic,partition span=1m\n| eval series=client_id.\"-\".topic.\"-\".partition\n| timechart span=1m max(value) by series",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "name": "search"
    },
    "ds_p91": {
      "type": "ds.search",
      "options": {
        "query": "| mstats avg(_value) as value WHERE index=cfk_metrics metric_name=\"kafka_network_requestmetrics_*thpercentile\" namespace=\"confluent\" env=\"$env$\" cluster=\"$cluster$\" name=\"TotalTimeMs\" service.name=\"kafka-broker\" service.instance.id=\"$instance$\" request=\"Produce\" BY metric_name,service.instance.id span=1m\n| eval series=metric_name.\"-\".'service.instance.id'\n| timechart span=1m avg(value) by series",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "name": "search"
    },
    "ds_p92": {
      "type": "ds.search",
      "options": {
        "query": "| mstats avg(_value) as value WHERE index=cfk_metrics metric_name=\"kafka_network_requestmetrics_*thpercentile\" namespace=\"confluent\" env=\"$env$\" cluster=\"$cluster$\" name=\"TotalTimeMs\" service.name=\"kafka-broker\" service.instance.id=\"$instance$\" request=\"FetchConsumer\" BY metric_name,service.instance.id span=1m\n| eval series=metric_name.\"-\".'service.instance.id'\n| timechart span=1m avg(value) by series",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "name": "search"
    }
  },
  "defaults": {
    "dataSources": {
      "ds.search": {
        "options": {
          "queryParameters": {
            "earliest": "-60m@m",
            "latest": "now"
          }
        }
      }
    }
  },
  "inputs": {
    "input_global_trp": {
      "type": "input.timerange",
      "title": "Time Range",
      "options": {
        "defaultValue": "-60m@m,now",
        "token": "global_time"
      }
    },
    "input_namespace": {
      "type": "input.dropdown",
      "title": "Namespace",
      "options": {
        "items": [
          {
            "label": "confluent",
            "value": "confluent"
          },
          {
            "label": "All",
            "value": "*"
          }
        ],
        "defaultValue": "confluent",
        "token": "namespace"
      }
    },
    "input_env": {
      "type": "input.dropdown",
      "title": "Environment",
      "options": {
        "items": [
          {
            "label": "local-poc",
            "value": "local-poc"
          },
          {
            "label": "All",
            "value": "*"
          }
        ],
        "defaultValue": "local-poc",
        "token": "env"
      }
    },
    "input_cluster": {
      "type": "input.dropdown",
      "title": "Cluster",
      "options": {
        "items": [
          {
            "label": "docker-desktop",
            "value": "docker-desktop"
          },
          {
            "label": "All",
            "value": "*"
          }
        ],
        "defaultValue": "docker-desktop",
        "token": "cluster"
      }
    },
    "input_instance": {
      "type": "input.text",
      "title": "Broker Instance (glob)",
      "options": {
        "defaultValue": "*",
        "token": "instance"
      }
    },
    "input_topic": {
      "type": "input.text",
      "title": "Topic (glob)",
      "options": {
        "defaultValue": "*",
        "token": "topic"
      }
    }
  },
  "layout": {
    "globalInputs": [
      "input_global_trp",
      "input_namespace",
      "input_env",
      "input_cluster",
      "input_instance",
      "input_topic"
    ],
