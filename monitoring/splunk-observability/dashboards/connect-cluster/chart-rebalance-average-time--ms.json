{
  "name": "Rebalance Average Time (ms)",
  "description": "kafka_connect_connect_worker_rebalance_metrics_rebalance_avg_time_ms, by worker instance.",
  "programText": "data('kafka_connect_connect_worker_rebalance_metrics_rebalance_avg_time_ms', filter=filter('namespace', 'confluent') and filter('service.name', 'kafka-connect')).sum(by=['service.instance.id']).publish(label='Rebalance Avg Time')\n",
  "options": {
    "type": "TimeSeriesChart",
    "defaultPlotType": "LineChart",
    "colorBy": "Dimension",
    "stacked": false,
    "includeZero": false,
    "axisPrecision": 3,
    "unitPrefix": "Metric",
    "lineChartOptions": {
      "showDataMarkers": false
    },
    "onChartLegendOptions": {
      "showLegend": true,
      "dimensionInLegend": "plot_label"
    },
    "programOptions": {
      "disableSampling": false,
      "timezone": "UTC"
    },
    "axes": [
      {
        "label": "ms"
      },
      null
    ]
  }
}
