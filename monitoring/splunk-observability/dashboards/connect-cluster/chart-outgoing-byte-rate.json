{
  "name": "Outgoing Byte Rate",
  "description": "kafka_connect_connect_metrics_outgoing_byte_rate, by worker instance + client_id.",
  "programText": "data('kafka_connect_connect_metrics_outgoing_byte_rate', filter=filter('namespace', 'confluent') and filter('service.name', 'kafka-connect')).sum(by=['service.instance.id','client_id']).publish(label='Outgoing Byte Rate')\n",
  "options": {
    "type": "TimeSeriesChart",
    "defaultPlotType": "LineChart",
    "colorBy": "Dimension",
    "stacked": false,
    "includeZero": false,
    "axisPrecision": 3,
    "unitPrefix": "Metric",
    "lineChartOptions": {
      "showDataMarkers": false
    },
    "onChartLegendOptions": {
      "showLegend": true,
      "dimensionInLegend": "plot_label"
    },
    "programOptions": {
      "disableSampling": false,
      "timezone": "UTC"
    },
    "axes": [
      null,
      null
    ]
  }
}
