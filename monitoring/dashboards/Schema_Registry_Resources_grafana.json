{
  "title": "Confluent Schema Registry Resources (Memory, CPU, JVM)",
  "tags": [
    "kafka",
    "schema-registry",
    "memory",
    "cpu",
    "jvm",
    "confluent"
  ],
  "timezone": "browser",
  "uid": "schema-registry-resources",
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(kube_pod_container_resource_limits{pod=~\"schemaregistry-.*\", container=\"schemaregistry\"}, namespace)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(kube_pod_container_resource_limits{namespace=~\"$namespace\", pod=~\"schemaregistry-.*\", container=\"schemaregistry\"}, cluster)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "env",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(kube_pod_container_resource_limits{namespace=~\"$namespace\", cluster=~\"$cluster\", pod=~\"schemaregistry-.*\", container=\"schemaregistry\"}, env)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(kube_pod_container_resource_limits{namespace=~\"$namespace\", env=~\"$env\", cluster=~\"$cluster\", pod=~\"schemaregistry-.*\", container=\"schemaregistry\"}, pod)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": "schemaregistry-.*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "title": "Container Memory",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 1,
      "title": "Container Memory Usage vs Limit",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=~\"$namespace\", env=~\"$env\", cluster=~\"$cluster\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}} - Usage",
          "refId": "A"
        },
        {
          "expr": "sum by (pod) (kube_pod_container_resource_limits{namespace=~\"$namespace\", env=~\"$env\", cluster=~\"$cluster\", pod=~\"$pod\", resource=\"memory\", container=\"schemaregistry\"})",
          "legendFormat": "{{pod}} - Limit",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*Limit.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Memory %",
      "type": "gauge",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=~\"$namespace\", env=~\"$env\", cluster=~\"$cluster\", pod=~\"$pod\"}) / sum by (pod) (kube_pod_container_resource_limits{namespace=~\"$namespace\", env=~\"$env\", cluster=~\"$cluster\", pod=~\"$pod\", resource=\"memory\", container=\"schemaregistry\"}) * 100",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        }
      }
