{
  "title": "Confluent REST Proxy Resources (Memory, CPU, JVM)",
  "tags": [
    "confluent",
    "rest-proxy",
    "resources"
  ],
  "timezone": "browser",
  "uid": "rest-proxy-resources-memory-cpu-jvm",
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(container_memory_working_set_bytes{pod=~\"kafkarestproxy.*\"}, namespace)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(container_memory_working_set_bytes{namespace=~\"$namespace\", pod=~\"kafkarestproxy.*\"}, cluster)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "env",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(container_memory_working_set_bytes{namespace=~\"$namespace\", cluster=~\"$cluster\", pod=~\"kafkarestproxy.*\"}, env)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "pod",
        "type": "query",
        "datasource": "prometheus",
        "query": "label_values(container_memory_working_set_bytes{namespace=~\"$namespace\", env=~\"$env\", cluster=~\"$cluster\", pod=~\"kafkarestproxy.*\"}, pod)",
        "refresh": 1,
        "regex": "",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "title": "Memory",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 1,
      "title": "Memory Usage vs Limit",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=~\"$namespace\", env=~\"$env\", cluster=~\"$cluster\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}} - Usage",
          "refId": "A"
        },
        {
          "expr": "sum by (pod) (kube_pod_container_resource_limits{namespace=~\"$namespace\", env=~\"$env\", cluster=~\"$cluster\", pod=~\"$pod\", resource=\"memory\", container=\"kafkarestproxy\"})",
          "legendFormat": "{{pod}} - Limit",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 2,
      "title": "Memory %",
      "type": "gauge",
      "gridPos": {
        "x": 0,
        "y": 9,
