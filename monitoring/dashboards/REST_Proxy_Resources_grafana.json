      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=~\"$namespace\", env=~\"$env\", cluster=~\"$cluster\", pod=~\"$pod\"}) / sum by (pod) (kube_pod_container_resource_limits{namespace=~\"$namespace\", env=~\"$env\", cluster=~\"$cluster\", pod=~\"$pod\", resource=\"memory\"}) * 100",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
