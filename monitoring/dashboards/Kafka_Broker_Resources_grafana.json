          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=~\"$namespace\", env=~\"$env\", cluster=~\"$cluster\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}} - Usage",
          "refId": "A"
        },
        {
          "expr": "sum by (pod) (kube_pod_container_resource_limits{namespace=~\"$namespace\", env=~\"$env\", cluster=~\"$cluster\", pod=~\"$pod\", resource=\"memory\", container=\"kafka\"})",
          "legendFormat": "{{pod}} - Limit",
          "refId": "B"
